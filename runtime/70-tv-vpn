#!/bin/sh
# Homebrew boot hook; detached launch does not wait for network or server.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
# /media/developer is writable by everyone: nothing runs from BASE unless BASE, its runtime and launch.cjs are root's
# and not links.
root_owned() { [ ! -L "$1" ] && [ "$(stat -c %u "$1" 2>/dev/null)" = 0 ]; }
if [ -f /media/developer/tv-vpn/runtime/launch.cjs ] && root_owned /media/developer/tv-vpn &&
    root_owned /media/developer/tv-vpn/runtime && root_owned /media/developer/tv-vpn/runtime/launch.cjs; then
    /usr/bin/node /media/developer/tv-vpn/runtime/launch.cjs boot >/dev/null 2>&1
fi
